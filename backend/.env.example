# Copy this file to .env and replace the placeholders with local values.
MONGODB_USERNAME=replace-with-database-username
MONGODB_PASSWORD=replace-with-database-password
MONGODB_URI=mongodb://127.0.0.1:27017/visualforge
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
