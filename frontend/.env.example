# Copy to .env.local. Leave VITE_API_URL empty in development: the Vite proxy forwards /api and /uploads.
# Set it to the backend's public address when the built frontend is hosted separately from the API
# (the backend must also list the frontend's address in CLIENT_ORIGIN).
VITE_API_URL=

# Optional: where `vite dev` / `vite preview` proxy the API (default http://localhost:5000).
VITE_PROXY_TARGET=
